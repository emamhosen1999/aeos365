# ------------------------------------------------------------------
# AEOS365 — SaaS host production environment configuration
# Generated on 2026-06-09
# ------------------------------------------------------------------

APP_NAME="AEOS365"
APP_ENV=production
APP_KEY=base64:e0pWwxeZ5FI7/VGZ9Uj8Gp+wPpo6Y5b3Soeu5y9dmYI=
APP_DEBUG=false
APP_URL=https://aeos365.com
APP_DOMAIN=aeos365.com
ADMIN_DOMAIN=admin.aeos365.com
PLATFORM_DOMAIN=aeos365.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

AERO_MODE=saas
BCRYPT_ROUNDS=12
APP_MAINTENANCE_DRIVER=file

# ------------------- Database (central landlord DB) ----------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aeos365_platform
DB_USERNAME=aeos365_emamhosen
DB_PASSWORD=jarvisMJ@321

# Tenant databases (stancl/tenancy creates one DB per tenant using the central
# connection as template). cPanel requires the account prefix on every DB name,
# so new tenants provision as e.g. aeos365_t<uuid>. Pre-imported demo tenant DBs
# must also carry this prefix (see docs/deployment/cpanel-deploy-runbook.md).
TENANCY_DB_PREFIX=aeos365_t
TENANCY_DB_SUFFIX=

# ------------------- Cache / Session / Queue -----------------------
# Database-backed drivers for cPanel/shared hosting compatibility.
# Eliminates Redis requirement. Tenant cache isolation is handled
# automatically by CachePrefixTenancyBootstrapper.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.aeos365.com
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=null

# ------------------- Filesystem ------------------------------------
# Using local disk storage as requested.
FILESYSTEM_DISK=local

# ------------------- Mail (cPanel SMTP via Cloudflare) -------------
# CLOUDFLARE WARNING: Cloudflare does not proxy SMTP mail ports (465/587).
# Make sure your "mail" DNS record (e.g. mail.aeos365.com) is set to
# "DNS Only" (Grey Clouded) in the Cloudflare dashboard.
MAIL_MAILER=smtp
MAIL_HOST=mail.aeos365.com
MAIL_PORT=465
MAIL_USERNAME=noreply@aeos365.com
MAIL_PASSWORD=jarvisMJ@321
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@aeos365.com
MAIL_FROM_NAME="${APP_NAME}"

# ------------------- Logging ---------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# ------------------- Vite / Frontend -------------------------------
VITE_APP_NAME="${APP_NAME}"

# ------------------- Aero / Platform -------------------------------
LICENSE_SERVER_URL=https://licenses.aeos365.com
LICENSE_BYPASS=false
